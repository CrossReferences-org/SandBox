<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/sandbox/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["SandBox.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />

    <style>
        :root {
            color-scheme: light;
            --paper: #fdfcf8;
            --ink: #1f1d1a;
            --ink-soft: #4a463f;
            --ink-faint: #8a857a;
            --rule: #e8e3d6;
            --rule-soft: #f0ebde;
            --parchment: #f7f3e8;
            --parchment-edge: #e3dcc6;
            --accent: #6b4423;
            --accent-soft: #8a5a30;
            --highlight: #fdf6e3;
        }

        body {
            font-family: Georgia, 'Iowan Old Style', 'Palatino Linotype', serif;
            margin: auto;
            max-width: 980px;
            /* padding: 0 1.2em; */
            color: var(--ink);
            background: var(--paper);
            line-height: 1.55;
            font-feature-settings: "onum" 1;
        }

        h1 {
            font-size: 1.5em;
            font-weight: normal;
            border-bottom: 1px solid var(--rule);
            padding-bottom: .35em;
            margin: 1.4em 0 .9em;
            letter-spacing: .01em;
        }

        .intro {
            color: var(--ink-soft);
            font-size: .95em;
            margin: 0 0 1.4em;
            font-style: italic;
        }

        .note { color: var(--ink-faint); font-style: italic; }

        /* Lookup form */
        form.lookup {
            display: flex;
            flex-wrap: wrap;
            gap: .8em 1em;
            align-items: end;
            padding: 1em 1.1em;
            background: var(--parchment);
            border: 1px solid var(--parchment-edge);
            border-radius: 4px;
            margin-bottom: 1.8em;
        }

        form.lookup label {
            display: flex;
            flex-direction: column;
            gap: .3em;
            font-size: .72em;
            letter-spacing: .08em;
            text-transform: uppercase;
            color: var(--ink-faint);
        }

        form.lookup input,
        form.lookup select {
            font: inherit;
            font-size: 1.18em;
            padding: .4em .55em;
            border: 1px solid #cfc8b3;
            border-radius: 3px;
            background: #fff;
            color: var(--ink);
            font-feature-settings: "tnum" 1;
            height: 2.5em;
        }

        form.lookup input:focus,
        form.lookup select:focus {
            outline: none;
            border-color: var(--accent-soft);
            box-shadow: 0 0 0 2px rgba(107, 68, 35, .15);
        }

        form.lookup input[type=number] { width: 5em; }
        form.lookup select[name=book] { min-width: 11em; }

        form.lookup button {
            font: inherit;
            font-size: .98em;
            padding: .5em 1.4em;
            border: 1px solid var(--accent);
            background: var(--accent);
            color: #fff;
            border-radius: 3px;
            cursor: pointer;
            letter-spacing: .03em;
        }

        form.lookup button:hover {
            background: var(--accent-soft);
            border-color: var(--accent-soft);
        }

        .lookup .form-row {
            display: flex;
            flex-wrap: wrap;
            gap: 1rem;
            align-items: end;
        }
        .lookup .form-row + .form-row {
            margin-top: 0.5rem;
        }

        /* Source verse block */
        .source {
            background: var(--parchment);
            padding: 1em 1.2em;
            border-left: 3px solid var(--accent);
            margin: 1em 0 2em;
            font-size: 1.05em;
            line-height: 1.65;
        }
        .source p { margin: .4em 0; }
        .split-note {
            font-size: .82em;
            color: var(--ink-faint);
            font-style: italic;
            margin-bottom: .55em;
        }

        /* Result rows */
        .row {
            display: grid;
            grid-template-columns: minmax(100px, max-content) 1fr;
            gap: 1em;
            padding: .75em .5em;
            border-bottom: 1px solid var(--rule-soft);
            align-items: baseline;
            transition: background-color .12s ease;
        }

        .row:not(.header):hover { background: var(--highlight); }

        .row.header {
            font-size: .72em;
            text-transform: uppercase;
            letter-spacing: .1em;
            color: var(--ink-faint);
            font-weight: normal;
            border-bottom: 1px solid var(--rule);
            padding-bottom: .5em;
        }

        .total {
            font-weight: bold;
            font-size: 1.05em;
            color: var(--ink-soft);
            font-feature-settings: "tnum" 1;
        }

        .breakdown {
            font-size: .85em;
            color: var(--ink-faint);
            font-family: 'SF Mono', Menlo, Consolas, monospace;
            font-feature-settings: "tnum" 1;
        }

        .ref {
            font-weight: bold;
            color: var(--accent);
            margin-bottom: .15em;
        }
        .ref a {
            color: inherit;
            text-decoration: none;
            border-bottom: 1px dotted transparent;
        }
        .ref a:hover { border-bottom-color: var(--accent-soft); }

        .text { color: var(--ink); line-height: 1.5; }

        /* Mobile */
        @@media (max-width: 768px) {
            body { margin: auto; /* padding: 0 .9em; */ line-height: 1.5; }
            h1 { font-size: 1.25em; }

            form.lookup { padding: .85em .9em; gap: .7em .8em; }
            form.lookup label { flex: 1 1 auto; }
            form.lookup input[type=number] { width: 100%; }
            form.lookup select[name=book] { min-width: 0; width: 100%; }
            form.lookup button { width: 100%; padding: .65em; margin-top: .2em; }

            .row {
                grid-template-columns: 1fr;
                grid-template-areas:
                    'ref'
                    'breakdown';
                gap: .15em;
                padding: .7em .25em;
            }
            .row > :nth-child(1) { grid-area: breakdown; font-size: .78em; }
            .row > :nth-child(2) { grid-area: ref; }
            .row.header { display: none; }
        }
        .anchor-phrase {
            --c1: #fff2a8;
            --c2: #c8e6c9;
            --c3: #ffd6e0;
            --c4: #cfe2ff;

            text-decoration: none;
            color: inherit;
            cursor: pointer;
            padding: 0 2px;
            border-radius: 2px;
            background: var(--bg, var(--c1));
        }

        .anchor-phrase:nth-of-type(4n+1) { --bg: var(--c1); }
        .anchor-phrase:nth-of-type(4n+2) { --bg: var(--c2); }
        .anchor-phrase:nth-of-type(4n+3) { --bg: var(--c3); }
        .anchor-phrase:nth-of-type(4n)   { --bg: var(--c4); }

        .anchor-phrase.active { outline: 2px solid #333; }

        /* ---- Verse-number badges (used everywhere) ---- */
        .vs-num {
            margin: 1px;
            padding: 2px;
            border-radius: 3px;
            color: #555;
            cursor: pointer;
            text-decoration: none;
        }
        .vs-num--context  { background-color: #ccc9; }
        .vs-num--cohort   { background-color: #fff; color: #000; cursor: default; }
        .vs-num--incoming { background-color: #ffddaa77; }
        .vs-num--outgoing { background-color: #aaddff66; }

        .vs-num--lvl1 { border: 1px solid #00000077; }
        .vs-num--lvl2 { border: 1px solid goldenrod; }
        .vs-num--lvl3 { border: 1px dashed #00000044; }

        /* ---- Link resets ---- */
        .lnk-plain { text-decoration: none; color: inherit; }
        .lnk-bare  { text-decoration: none; }

        /* ---- Dimmed context verse text ---- */
        .context-text { color: #888; }

        /* ---- Collected panel ---- */
        .collected {
            margin: 1rem 0;
            padding: 1rem;
            border: 1px solid #ddd;
            border-radius: 6px;
            background: #fafafa;
        }
        .collected__summary {
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
            user-select: none;
        }
        .collected__actions {
            display: flex;
            align-items: center;
            gap: 2rem;
        }
        .collected__clear {
            color: #6b7280;
            text-decoration: underline;
            font-size: 0.85rem;
        }
        .collected__run {
            padding: 0.5rem 1.5rem;
            background-color: #a73;
            color: #fff;
            text-decoration: none;
            font-weight: bold;
            font-size: 0.9rem;
            border-radius: 4px;
        }
        .collected__list {
            margin-top: 1.25rem;
            padding-left: 1.5rem;
        }
        .collected__item { margin-bottom: 0.5rem; }

        /* ---- Score breakdown bar ---- */
        .score-bar {
            display: flex;
            height: 4px;
            margin-top: 3px;
            background: #e6e6e6;
            border-radius: 2px;
            overflow: hidden;
        }
        .score-bar__seg--l1       { background: #186ac8; }
        .score-bar__seg--incoming { background: #ffaa63c3; }
        .score-bar__seg--overlap  { background: #b69a63c3; }
        .score-bar__seg--l2       { background: #74a6d5; }
        .score-bar__seg--l3       { background: #a6bbced4; }
    </style>
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
